# Copy this file to .env before starting the Docker stack.
# Never commit the real .env file.

POSTGRES_DB=gestion_conges
POSTGRES_USER=gestion_conges
POSTGRES_PASSWORD=change-this-local-password

# HS256 requires a secret of at least 32 bytes.
# Example generation command: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
